# Ignore all dotfiles/directories except this file
.*
!.gitignore

# Host env files (keep *.env.example)
*.env
!*.env.example

# Secrets / credentials
*.pem
*.key
*.p12
*.pfx
*credentials*
*secret*

# lm-eval venv + bulky results
lm-eval/bin/
lm-eval/lib/
lm-eval/lib64/
lm-eval/include/
lm-eval/share/
lm-eval/pyvenv.cfg
lm-eval/CACHEDIR.TAG
lm-eval/**/cache.db*
lm-eval/**/__pycache__/
lm-eval/results/**/samples_*.jsonl
lm-eval/results/**/*.db
lm-eval/results/**/resume.log
lm-eval/results/**/watchdog.log
lm-eval/results/**/serve.log
lm-eval/results/**/agent_loop.log
lm-eval/results/**/*.state

# text8-repro local data and outputs
text8-repro/.env
text8-repro/data/
text8-repro/checkpoints/
text8-repro/runs/
text8-repro/cache/
text8-repro/results/*.json
text8-repro/results/*.txt
text8-repro/results/provenance.md
text8-repro/**/*.pt
text8-repro/**/text8
text8-repro/**/text8.zip
text8-repro/**/__pycache__/
text8-repro/**/*.pyc

!text8-repro/.dockerignore
!.dockerignore
!**/.dockerignore
