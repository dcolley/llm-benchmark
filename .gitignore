# Ignore all dotfiles/directories except this file
.*
!.gitignore

# Host env files (keep *.env.example)
*.env
!*.env.example

# Secrets / credentials
*.pem
*.key
*.p12
*.pfx
*credentials*
*secret*

# lm-eval venv + bulky results
lm-eval/bin/
lm-eval/lib/
lm-eval/lib64/
lm-eval/include/
lm-eval/share/
lm-eval/pyvenv.cfg
lm-eval/CACHEDIR.TAG
lm-eval/**/cache.db*
lm-eval/**/__pycache__/
lm-eval/results/**/samples_*.jsonl
lm-eval/results/**/*.db
lm-eval/results/**/resume.log
lm-eval/results/**/watchdog.log
lm-eval/results/**/serve.log
lm-eval/results/**/agent_loop.log
lm-eval/results/**/*.state
