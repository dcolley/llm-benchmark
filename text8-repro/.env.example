# Copy to .env and fill in host paths. Do not commit .env.
# Use absolute host paths. Do not put hostnames or IP addresses here.

# Read-only snapshot downloaded by the fetch profile (contains transformer/ and ssm/).
HF_DIR=/absolute/path/to/hf-snapshot

# Read-only directory that contains the extracted `text8` file.
TEXT8_DIR=/absolute/path/to/text8-dir

# Writable outputs
RESULTS_DIR=/absolute/path/to/results
RUNS_DIR=/absolute/path/to/runs
CACHE_DIR=/absolute/path/to/cache

# Single GPU visible inside each service. Do not list multiple IDs (no TP).
NVIDIA_VISIBLE_DEVICES=0

SEED=1
DEVICE=cuda
MICROBATCH=4
WALL_SECONDS=259200
IMAGE_NAME=text8-repro:phasemesh

# Used by host-side or fetch-profile scripts
HF_REPO=MarxistLeninist/phasemesh-text8-comparison
HF_REVISION=2eb1bef95b39e9745035044679f9d18b8ac3513a
HF_BASE_URL=https://huggingface.co
TEXT8_URL=http://mattmahoney.net/dc/text8.zip
TEXT8_EXPECTED_SHA256=6e890197040d37d85beb962ae1f041ff1d9a9ca8d20c7d99c85027eebf51dca7
UPSTREAM_REPO=https://github.com/ashhart/PhaseMesh
UPSTREAM_COMMIT=3ae43ffac6c0699857cada0865f156405fb95956

# Persistent writable checkout used by scripts/provenance_diff.sh
UPSTREAM_DIR=/absolute/path/to/PhaseMesh-checkout

# Ownership of files written by compose (results, runs, cache)
UID=1000
GID=1000
