# Copy to qwen-agentworld-2spark.env on BOTH Sparks and edit.

# --- Cluster topology ---
# Head (Spark A):   management <head-mgmt-ip>   interconnect <head-interconnect-ip>
# Worker (Spark B): management <worker-mgmt-ip> interconnect <worker-interconnect-ip>
#
# Use interconnect IPs for NCCL; API is on head mgmt: http://<head-mgmt-ip>:8000/v1

# Torch distributed master (head interconnect IP).
HEAD_ADDR=<head-interconnect-ip>

# This node's rank: 0 on head, 1 on worker.
NODE_RANK=0

# NCCL / vLLM bind address on the direct Spark link (not 127.0.0.1).
HOST_IP=<this-node-interconnect-ip>

# QSFP interconnect interface (Up in `ip -br link`; see NVIDIA NCCL playbook).
NCCL_IFNAME=enp1s0f0np0

MASTER_PORT=29501
EXPECTED_VLLM_VERSION=0.23.0

# --- Model / server ---
MODEL=Qwen/Qwen-AgentWorld-35B-A3B
PORT=8000
MAX_MODEL_LEN=131072

# Required for Hermes / clients that send tool_choice=auto
ENABLE_AUTO_TOOL_CHOICE=1
TOOL_CALL_PARSER=qwen3_xml

# --- Paths (same venv layout on both nodes) ---
# See readme-venv.md
VLLM_VENV=$HOME/vllm/.venv

# First-boot compile parallelism. Keep STOP_EARLYOOM=1 when raising these.
MAX_JOBS=4
FLASHINFER_NVCC_THREADS=2
OMP_NUM_THREADS=4

# Optional: stop earlyoom during first kernel compile (both nodes).
# STOP_EARLYOOM=1
